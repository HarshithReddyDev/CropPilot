# CropPilot Backend Configuration

# App
APP_NAME=CropPilot
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=change-this-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local development only: when true AND ENVIRONMENT is not production, API
# requests without credentials are served as a deterministic development
# identity (no database user is created). Production always requires real
# JWT validation even if this flag is set. Never enable in production.
# DEV_AUTH_BYPASS=true

# PostgreSQL
POSTGRES_USER=croppilot
POSTGRES_PASSWORD=croppilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=croppilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenWeather
OPENWEATHER_API_KEY=your-openweather-api-key

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=croppilot-backend

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=croppilot-media

# Celery
CELERY_WORKER_CONCURRENCY=4

# Market Intelligence. Active provider: AGMARKNET Direct (public web backend,
# no API key). The OGD client stays dormant for future use; a missing
# DATA_GOV_API_KEY must never break Market Intelligence.
# Reported mandi data is observational and may have publication/ingestion
# delay. Prices shown are latest reported observations, not guaranteed
# future prices. Source and observation date are shown to users.
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1/
AGMARKNET_TIMEOUT=30
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
# Optional deployment preference only; empty means national scope.
MARKET_DEFAULT_STATE=
DATA_GOV_TIMEOUT=30
DATA_GOV_PAGE_SIZE=100
# Upper bound on records stored per ingestion run.
MARKET_INGEST_MAX_RECORDS=20000
MARKET_INGEST_CONCURRENCY=4
MARKET_INGEST_CRON_HOUR=6
MARKET_INGEST_CRON_MINUTE=30

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# AI Assistant (local-first; cloud keys optional, unset = provider skipped)
ASSISTANT_ENABLED=true
ASSISTANT_LLM_MODE=local_first
ASSISTANT_PROVIDER_ORDER=gemini,openrouter,groq,ollama
ASSISTANT_LOCAL_MODEL=qwen3:8b
ASSISTANT_FALLBACK_MODEL=qwen3:4b
ASSISTANT_MAX_TOOL_STEPS=5
ASSISTANT_REQUEST_TIMEOUT=60
ASSISTANT_COOLDOWN_SECONDS=300
OPENROUTER_API_KEY=
# Legacy single model (used only when tiering is off). Free ids rotate;
# verify against GET https://openrouter.ai/api/v1/models before use.
# qwen/qwen3-8b:free was delisted (404 as of 2026-09-26); a verified
# alternative is qwen/qwen3.8-27b:free.
OPENROUTER_MODEL=
# OpenRouter free-tier rotation (deterministic Tier 1 -> 2 -> 3 -> Ollama).
# Budgets are LOCAL app caps, not provider quotas. Tier models must end in
# ":free" (non-free values are rejected, never silently routed paid).
# Leave TIER_N_MODEL empty to disable that tier. Disabled by default:
# local-only mode must keep working with no keys.
ASSISTANT_OPENROUTER_TIERING_ENABLED=false
ASSISTANT_OPENROUTER_TIER_1_MODEL=
ASSISTANT_OPENROUTER_TIER_1_MAX_REQUESTS=20
ASSISTANT_OPENROUTER_TIER_1_MAX_TOKENS=100000
ASSISTANT_OPENROUTER_TIER_1_TOOL_CALLING=true
ASSISTANT_OPENROUTER_TIER_2_MODEL=
ASSISTANT_OPENROUTER_TIER_2_MAX_REQUESTS=20
ASSISTANT_OPENROUTER_TIER_2_MAX_TOKENS=100000
ASSISTANT_OPENROUTER_TIER_2_TOOL_CALLING=true
ASSISTANT_OPENROUTER_TIER_3_MODEL=
ASSISTANT_OPENROUTER_TIER_3_MAX_REQUESTS=20
ASSISTANT_OPENROUTER_TIER_3_MAX_TOKENS=100000
ASSISTANT_OPENROUTER_TIER_3_TOOL_CALLING=true
ASSISTANT_OPENROUTER_TOKEN_RESERVE=2000
ASSISTANT_USAGE_TIMEZONE=UTC
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ASSISTANT_ASR_ENGINE=disabled
ASSISTANT_TTS_ENGINE=disabled
# V1.3 voice + translation (FOSS local engines; all optional).
# ASR: faster-whisper (Whisper, local). Model: tiny|base|small|medium|large-v3.
# Device auto = cuda when torch sees a GPU else cpu.
ASSISTANT_ASR_MODEL=base
ASSISTANT_ASR_DEVICE=auto
# TTS: auto = indic-parler when its weights are cached, else espeak-ng
# fallback when ASSISTANT_TTS_FALLBACK=espeak-ng, else text-only.
# Parler weights are gated (HF account acceptance) — see docs/assistant-voice.md.
ASSISTANT_TTS_MODEL=ai4bharat/indic-parler-tts
ASSISTANT_TTS_DEVICE=auto
ASSISTANT_TTS_FALLBACK=espeak-ng
ASSISTANT_TTS_TIMEOUT_S=30
ASSISTANT_TTS_MAX_CHARS=2000
# Voice session behavior.
ASSISTANT_VOICE_ENABLED=true
ASSISTANT_AUTO_SPEAK=false
ASSISTANT_DEFAULT_LANGUAGE=en
ASSISTANT_AUTO_LANGUAGE_DETECTION=true
ASSISTANT_PERSIST_AUDIO=false
# IndicTrans2 runtime bridge (MIT checkpoints, gated download).
# Directions auto-resolve; indic-indic pivots through English.
ASSISTANT_MT_DEVICE=auto
ASSISTANT_MT_CONCURRENCY=1
ASSISTANT_MT_TIMEOUT_S=60
ASSISTANT_MT_MODEL=
ASSISTANT_RAG_TOP_K=12
ASSISTANT_RAG_RERANK_K=5
ASSISTANT_EMBEDDING_MODEL=bge-m3

# Disease diagnosis platform (evidence-aware, CPU-first, no paid deps).
# Models lazy-download once from HF Hub into DISEASE_MODEL_CACHE_DIR and are
# reused under a bounded LRU (DISEASE_MAX_LOADED_MODELS). Research-only and
# unlicensed models never enter production unless RESEARCH=true.
DISEASE_ENABLED=true
DISEASE_MODEL_CACHE_DIR=/models/disease
DISEASE_MAX_LOADED_MODELS=3
DISEASE_MAX_PARALLEL_SPECIALISTS=3
DISEASE_MODEL_LOAD_TIMEOUT=120
DISEASE_INFERENCE_TIMEOUT_SECONDS=20
DISEASE_MAX_IMAGE_MB=10
DISEASE_MAX_PIXELS=25000000
DISEASE_ENABLE_RESEARCH_MODELS=false
DISEASE_ENABLE_VLM_FALLBACK=true
DISEASE_ROUTER_MODE=auto
DISEASE_ROUTER_HEAD_PATH=
DISEASE_PROTOTYPE_INDEX_PATH=
DISEASE_VLM_PROVIDER=
DISEASE_VLM_MODEL=
