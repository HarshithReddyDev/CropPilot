# CropPilot Frontend Configuration

# Backend API URL (defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local development only: when true, the app skips the sign-in requirement
# because the development backend serves a deterministic dev identity
# (see backend DEV_AUTH_BYPASS). Never set this in production builds.
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# Mapbox Access Token (required for Maps page)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Default map style
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/satellite-streets-v12
